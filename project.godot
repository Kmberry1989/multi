[application]

config/name="Godot 3D Multiplayer Template"
config/description="This is a foundational template for a 3D multiplayer game, developed in Godot Engine."
config/tags=PackedStringArray("3d", "network")
run/main_scene="res://scenes/level/level.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Network="*res://scripts/network.gd"
ItemDatabase="*res://scripts/item_database.gd"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="Godot 3D Multiplayer Template"

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg", "res://addons/deep_raycast_3d/plugin.cfg", "res://addons/flowing-sky/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

